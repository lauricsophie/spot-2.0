
# Mistral API
MISTRAL_API_KEY=your-mistral-api-key

# API authentication
API_TOKEN=your-api-token

# Server
PORT=3000

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Environment: development | production | test
NODE_ENV=development

# DECP endpoint
DECP_ENDPOINT=https://your-decp-api-endpoint.com/api

# PostgreSQL (with pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/cerc_spot

# Model provider: mistral | openai | dev
MODEL_PROVIDER=mistral
MISTRAL_MODEL_ID=mistral-large-latest

# OpenAI (si MODEL_PROVIDER=openai)
OPENAI_MODEL_ID=gpt-4o
OPENAI_API_KEY=your-openai-api-key

# Modele dev auto-heberge (si MODEL_PROVIDER=dev)
DEV_MODEL_NAME=Qwen
DEV_MODEL_ID=Qwen/Qwen3.6-35B-A3B
DEV_MODEL_API_KEY=your-dev-model-api-key
# Doit pointer vers le port local forwarde par le tunnel, pas vers l'IP distante
DEV_MODEL_ENDPOINT=http://localhost:8000/v1

# Tunnel SSH (requis si MODEL_PROVIDER=dev)
SSH_TUNNEL_HOST=bastion-ip
SSH_TUNNEL_USER=your-ssh-user
# Cle privee en PEM brut ou en base64
SSH_TUNNEL_KEY=your-private-key-base64
SSH_TUNNEL_PORT=22
# Format localPort:remoteHost:remotePort. remoteHost est resolu DEPUIS le bastion :
# mettre l'IP du serveur du modele si ce n'est pas le bastion lui-meme.
SSH_TUNNEL_FORWARD=8000:model-server-ip:8000
